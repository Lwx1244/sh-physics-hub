# ============================================================
# 上海高中物理平台 —— 环境变量配置模板
# 使用方法：复制本文件为 .env 并修改对应值
#   cp .env.example .env
# （.env 不会被上传到代码仓库，里面含密码，请勿提交）
# 云平台部署时也可直接在平台后台的「环境变量」里逐项填写，
# 平台注入的环境变量优先级高于本文件。
# ============================================================

# ---- 服务端口（云服务器/平台默认 3000 即可；部分平台会强制注入 PORT）----
PORT=3000

# ---- 会话密钥（务必改成一段随机长字符串，否则有被伪造会话的风险）----
SESSION_SECRET=change_me_to_a_long_random_string_please

# ---- 后台管理员账号 / 密码 / 手机号（首次启动自动创建；上线前务必修改！）----
ADMIN_USER=admin
ADMIN_PASS=admin123
ADMIN_PHONE=13800138000

# ---- 上传文件目录（云端可用对象存储挂载路径覆盖，如 /data/uploads）----
UPLOAD_DIR=./uploads

# ---- 数据库（二选一）----
# 方案 A：本地文件模式（默认，单机云服务器足够，数据存服务器磁盘）
DATABASE_URL=file:./data/physics.db

# 方案 B：Turso 托管云库（永久在线、数据不在本地、多实例共享，推荐）
# 1) 打开 https://turso.tech 注册（免费）
# 2) 建库：turso db create sh-physics
# 3) 拿地址：turso db show sh-physics --url  →  libsql://sh-physics-xxxx.turso.io
# 4) 发令牌（有效期 1 年，到期前记得 renew）：turso db tokens create sh-physics --expiration 8760h
# 5) 取消下面两行注释并填入，重启服务即可（题库会自动灌进云端库）
# DATABASE_URL=libsql://sh-physics-xxxx.turso.io
# DATABASE_AUTH_TOKEN=你拿到的令牌
